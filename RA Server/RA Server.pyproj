    <Name>RA Server</Name>
    <RootNamespace>RA_Server</RootNamespace>
    <SuppressEnvironmentCreationPrompt>True</SuppressEnvironmentCreationPrompt>
    <InterpreterId>Global|VisualStudio|venv (Python 3.14 (64-bit))</InterpreterId>
